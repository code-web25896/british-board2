# ================================================================
# British Board UK - Hostinger Node.js Environment Configuration
# ================================================================

# NODE_ENV: Set to 'production' for live deployments on Hostinger.
NODE_ENV=production

# PORT: The port the Node.js application listens on.
# Hostinger assigns this automatically or defaults to 3000.
PORT=3000

# APP_URL: The canonical public URL of your website on Hostinger.
# Example: https://yourdomain.com or https://british-board.uk
APP_URL="https://yourdomain.com"
